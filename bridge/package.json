    "test:openclaw": "pnpm run build && node scripts/test-openclaw.mjs",
    "test:e2e": "pnpm run build && node scripts/test-e2e.mjs",
    "test:loader": "node scripts/test-loader.mjs",
    "test:runtime": "pnpm run build && node scripts/test-runtime.mjs",
    "test:compat": "pnpm run build && node scripts/test-dsh-compat.mjs",
    "test:live:deepseek": "pnpm run build && node scripts/test-e2e.mjs --live-deepseek",
    "pack:release": "pnpm run build && node scripts/pack-release.mjs",
    "test:installation": "node scripts/test-installation.mjs",
    "benchmark": "pnpm run build && tsx scripts/benchmark.ts",
    "conest": "tsx src/cli.ts",
    "bridge": "tsx src/cli.ts",
    "demo:studio": "node scripts/demo-studio.mjs",
    "test:studio": "node scripts/demo-studio.mjs --verify"
  },
  "dependencies": {
